# ─────────────────────────────────────────────────────────────
# 채널은 "토큰이 있으면 켜진다". 둘 다 넣으면 두 곳 모두로 알림이 갑니다.
# 최소 하나는 있어야 실행됩니다.
# ─────────────────────────────────────────────────────────────

# ── 텔레그램 ────────────────────────────────────────────────
# @BotFather 에게 /newbot 으로 발급받은 토큰
TELEGRAM_BOT_TOKEN=

# (선택) 알림을 받을 chat id 고정. 비워두면 봇에게 /start 를 처음 보낸 대화에 자동으로 묶입니다.
# TELEGRAM_CHAT_ID=

# ── 디스코드 ────────────────────────────────────────────────
# 개발자 포털(https://discord.com/developers/applications) > Bot > Token
# 봇 토큰을 넣으면 명령(!status 등)까지 받을 수 있습니다.
DISCORD_BOT_TOKEN=

# (선택) 알림을 받을 채널 id 고정. 비워두면 !start 를 처음 보낸 채널에 묶입니다.
# DISCORD_CHANNEL_ID=

# (선택) 서버(길드) 채널에서도 명령을 읽으려면 true.
# 개발자 포털 > Bot > MESSAGE CONTENT INTENT 를 먼저 켜야 합니다.
# DM 으로만 쓸 거라면 켤 필요 없습니다.
# DISCORD_MESSAGE_CONTENT_INTENT=false

# (선택) 봇 대신 웹훅만 쓸 때. 발송 전용이라 명령은 받을 수 없습니다.
# DISCORD_BOT_TOKEN 이 비어 있을 때만 사용됩니다.
# DISCORD_WEBHOOK_URL=

# ── 기타 ────────────────────────────────────────────────────
# 설정 파일(config.json)이 저장되는 위치. 기본값: 이 저장소 안의 data/
# FAIRY_DATA_DIR=

# 로그가 쌓이는 위치. 기본값: 이 저장소 안의 logs/
# FAIRY_LOG_DIR=
