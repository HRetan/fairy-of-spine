<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <!-- 명령을 받으려면 상주해야 하므로 cron 방식이 아니라 KeepAlive 데몬으로 띄운다. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__WORKDIR__/src/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- 죽자마자 재시작을 반복하지 않도록 최소 간격을 둔다. -->
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__LOGDIR__/fairy.log</string>

  <key>StandardErrorPath</key>
  <string>__LOGDIR__/fairy.error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>NODE_NO_WARNINGS</key>
    <string>1</string>
  </dict>
</dict>
</plist>
